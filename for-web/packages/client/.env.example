# By default, the client uses the official hosted Stoat backend.
# To connect a local Stoat instance, uncomment and adjust these values:
# VITE_HOST=localhost:4173
# VITE_API_URL=http://localhost:14702

# Dev server overrides (applies to default instance)
# VITE_DEV_WS_URL=ws://localhost:14703
# VITE_DEV_MEDIA_URL=http://localhost:14704
# VITE_DEV_PROXY_URL=http://localhost:14705
# VITE_DEV_GIFBOX_URL=http://localhost:14706

# specify Sentry DSN
VITE_SENTRY_DSN=
VITE_SENTRY_TUNNEL=

# Optional overrides; the shared soundboard has public project defaults.
# Never add a Supabase secret key or a bot token to VITE_ variables.
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
